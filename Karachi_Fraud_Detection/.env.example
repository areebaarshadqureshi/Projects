# Karachi Real Estate Fraud Detection — Environment Variables
# Copy this file to .env and adjust values as needed.
# None of these are secrets; defaults work for local development.

# Model and artifact paths (used by Docker and the FastAPI app)
MODEL_PATH=models/fraud_detector_v1.pkl
ARTIFACTS_PATH=models/artifacts

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Python runtime
PYTHONUNBUFFERED=1
